+def test_generate_token_ids_excludes_special_tokens():
+    """Llama, Mistral and Gemma tokenizers prepend a BOS id in ``encode``. Trace
+    blocks are joined mid-prompt and decoded with ``skip_special_tokens=True``, so
+    a BOS inside a block is dropped and the prompt comes out one token short per
+    hash ID."""
+    bos = 10_000
+    proc = Mock()
+    proc.encode.side_effect = lambda text, add_special_tokens=True: (
+        ([bos] if add_special_tokens else []) + list(range(len(text.split())))
+    )
+    res = generate_token_ids(10, proc, Faker())
+    assert len(res) == 10
+    assert bos not in res
+
+
