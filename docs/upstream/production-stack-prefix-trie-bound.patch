diff --git a/src/tests/test_hashtrie.py b/src/tests/test_hashtrie.py
new file mode 100644
index 0000000..5aa52e7
--- /dev/null
+++ b/src/tests/test_hashtrie.py
@@ -0,0 +1,115 @@
+import random
+
+import pytest
+
+from vllm_router.prefix.hashtrie import HashTrie
+
+CHUNK = 128
+A, B, C = "http://engine-a.com", "http://engine-b.com", "http://engine-c.com"
+
+
+def chunks(label: str, n: int = 1) -> str:
+    """A prompt of exactly n chunks, all distinct from each other and from
+    every other label's chunks."""
+    return "".join(f"{label}:{i}".ljust(CHUNK, ".") for i in range(n))
+
+
+def count_nodes(trie: HashTrie) -> int:
+    stack, n = [trie.root], 0
+    while stack:
+        node = stack.pop()
+        n += len(node.children)
+        stack.extend(node.children.values())
+    return n
+
+
+async def match_length(trie: HashTrie, prompt: str, endpoints=None) -> int:
+    length, _ = await trie.longest_prefix_match(prompt, endpoints or {A, B, C})
+    return length
+
+
+@pytest.mark.asyncio
+async def test_unbounded_by_default_keeps_every_chunk():
+    trie = HashTrie()
+    for i in range(50):
+        await trie.insert(chunks(f"p{i}"), A)
+    assert trie.num_nodes == count_nodes(trie) == 50
+    assert await trie.longest_prefix_match(chunks("p0"), {A}) == (CHUNK, {A})
+
+
+@pytest.mark.asyncio
+async def test_bound_holds_per_endpoint_under_random_traffic():
+    trie = HashTrie(max_chunks_per_endpoint=10)
+    rng = random.Random(0)
+    for i in range(500):
+        await trie.insert(chunks(f"p{i}", rng.randint(1, 4)), rng.choice([A, B, C]))
+        assert trie.num_nodes == count_nodes(trie) <= 30
+        assert all(len(listed) <= 10 for listed in trie._recency.values())
+
+
+@pytest.mark.asyncio
+async def test_least_recently_used_prompt_is_forgotten_first():
+    trie = HashTrie(max_chunks_per_endpoint=2)
+    await trie.insert(chunks("old"), A)
+    await trie.insert(chunks("new"), A)
+    await trie.insert(chunks("old"), A)  # touched: "old" is now the most recent
+    await trie.insert(chunks("newest"), A)  # over budget: "new" goes
+    assert await match_length(trie, chunks("new")) == 0
+    assert await match_length(trie, chunks("old")) == CHUNK
+    assert await match_length(trie, chunks("newest")) == CHUNK
+    assert trie.num_nodes == count_nodes(trie) == 2
+
+
+@pytest.mark.asyncio
+async def test_tail_chunks_are_forgotten_before_head_chunks():
+    """As a vLLM instance frees a request's blocks tail first: the prefix survives."""
+    trie = HashTrie(max_chunks_per_endpoint=4)
+    await trie.insert(chunks("doc", 3), A)
+    await trie.insert(chunks("other", 3), A)  # 6 listed, 4 allowed: doc's tail goes
+    assert await match_length(trie, chunks("doc", 3)) == CHUNK
+    assert await match_length(trie, chunks("other", 3)) == 3 * CHUNK
+    assert trie.num_nodes == count_nodes(trie) == 4
+
+
+@pytest.mark.asyncio
+async def test_forgetting_one_endpoint_keeps_the_others_listing():
+    trie = HashTrie(max_chunks_per_endpoint=1)
+    await trie.insert(chunks("shared"), A)
+    await trie.insert(chunks("shared"), B)
+    await trie.insert(chunks("a-only"), A)  # A forgets "shared"; B still lists it
+    assert await trie.longest_prefix_match(chunks("shared"), {A, B}) == (CHUNK, {B})
+    assert trie.num_nodes == count_nodes(trie) == 2
+
+
+@pytest.mark.asyncio
+async def test_node_is_dropped_once_no_endpoint_lists_it():
+    trie = HashTrie(max_chunks_per_endpoint=1)
+    await trie.insert(chunks("shared"), A)
+    await trie.insert(chunks("shared"), B)
+    await trie.insert(chunks("a-only"), A)
+    await trie.insert(chunks("b-only"), B)
+    assert await match_length(trie, chunks("shared")) == 0
+    assert trie.num_nodes == count_nodes(trie) == 2
+
+
+@pytest.mark.asyncio
+async def test_listings_stay_prefix_closed_however_inserts_interleave():
+    """A chunk an endpoint lists has a parent it lists, so a match never
+    dead-ends above a surviving suffix."""
+    trie = HashTrie(max_chunks_per_endpoint=6)
+    rng = random.Random(1)
+    for i in range(300):
+        head = chunks(f"h{rng.randint(0, 3)}", rng.randint(1, 2))
+        tail = chunks(f"t{i}", rng.randint(0, 3))
+        await trie.insert(head + tail, rng.choice([A, B]))
+        for endpoint, listed in trie._recency.items():
+            for node in listed:
+                assert node.parent is trie.root or endpoint in node.parent.endpoints
+
+
+@pytest.mark.asyncio
+async def test_a_bound_below_one_prompt_keeps_its_head():
+    trie = HashTrie(max_chunks_per_endpoint=2)
+    await trie.insert(chunks("long", 5), A)
+    assert await match_length(trie, chunks("long", 5)) == 2 * CHUNK
+    assert trie.num_nodes == count_nodes(trie) == 2
